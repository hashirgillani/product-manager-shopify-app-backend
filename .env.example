# Backend configuration (product-manager-backend)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=

# Public URL of THIS backend. In dev, set this to your ngrok URL
# (e.g. https://abc123.ngrok-free.app) after running: ngrok http 3000
# Must be an HTTPS URL; also add it to Partner Dashboard -> App -> App URL / redirect URLs.
HOST=

# Where the frontend is served. In dev, http://localhost:5173 (Vite dev server).
FRONTEND_URL=

MONGODB_URI=
BACKEND_PORT=

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=